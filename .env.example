# Template for install-env.sh, the file that actually holds this install's secrets.
#
# You normally don't create install-env.sh by hand: run `./configure-env.sh`, which
# interactively asks for each of these and writes install-env.sh for you. This file exists
# purely as a reference for what's in there and is safe to commit — it has no real secrets in it.
#
# install-env.sh itself is gitignored. Never commit it.

# Public domain the platform is served on, and the cluster-wide password used for every
# component (databases, OAuth2 client secrets, the first identity-provider user). Change both.
export CAMUNDA_DOMAIN="camunda.example.com"
export PASSWORD="Choose_a_secure_password_please"

# Derived automatically by configure-env.sh - shown here for completeness only.
export ZEEBE_DOMAIN="zeebe.camunda.example.com"

# Camunda Helm chart / application version. See https://helm.camunda.io/camunda-platform/version-matrix/
export HELM_CHART_VERSION="15.0.0-alpha2"
export CAMUNDA_APP_VERSION="8.10.0"

# camunda-demo-identity-provider image (see camunda-demo-identity-provider/.env.example for its
# own local-dev secrets) and the platform's first admin user. The user's password is $PASSWORD
# above, not a separate variable.
export IDP_IMAGE="ghcr.io/jeltechnologies/camunda-demo-identity-provider:0.1.0"
export DEMO_USERNAME="demo"
export DEMO_EMAIL="demo@example.com"

# Third-party component versions.
export ES_VERSION="8.19.9"
export PG_VERSION="16"

# Optional: Ollama AI copilot in Web Modeler.
export OLLAMA_ENABLED="false"
export OLLAMA_MODEL="my-model"
export OLLAMA_URL="http://my-ollama:11434"

# Optional: GitLab Git Sync in Web Modeler. Leave empty to disable.
export GITLAB_URL=""

# Set to "true" only when this box sits behind a reverse proxy (Cloudflare, Pangolin, ...) that
# already resolves CAMUNDA_DOMAIN publicly - skips writing /etc/hosts entries.
export BEHIND_REVERSE_PROXY="false"

# WARNING: exposes the full REST API surface unauthenticated when "true". Keep "false" unless
# you specifically need it, and never enable it on a box reachable from the public internet.
export SWAGGER_ENABLED="false"
