# Generated by configure-env.sh - contains the cluster password and other secrets.
# See .env.example for the shape of this file without real values.
install-env.sh
.env

# Rendered Helm values - contains no secrets directly but is build output, never edit by hand.
values-camunda.yaml

# User-provided connector credentials (see README's "Secrets" section).
connector-secrets.yaml

# Locally installed via `npx skills add` (see INSTALL_C8CTL_SKILLS in configure-env.sh) -
# reproducible from that command, not repo content.
.agents/
.claude/
skills-lock.json
