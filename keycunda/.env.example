# Local-dev secrets for running keycunda outside Kubernetes.
#
# Copy this file to .env, fill in real values, then load it into your shell before running the
# app (see README.md). .env is gitignored - never commit it. This file has no real secrets and
# is safe to commit.

# A local Postgres instance with a "keycunda" database (see ../template-postgresql.yaml for the
# schema this mirrors in the real cluster).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/keycunda
SPRING_DATASOURCE_USERNAME=keycunda
SPRING_DATASOURCE_PASSWORD=keycunda

# Used to build OAuth2 redirect URIs - "localhost" is fine for local testing.
CAMUNDA_DOMAIN=localhost

# The first admin user, seeded once on startup when the users table is empty.
DEMO_NAME=demo
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo

# OAuth2 client secrets for the confidential Camunda component clients (camunda-identity,
# orchestration, connectors, optimize). Any value works for local testing - these just need to
# match whatever a local Camunda install (or a manual curl/Postman client) is configured with.
IDENTITY_IDENTITY_CLIENT_TOKEN=changeme
IDENTITY_ORCHESTRATION_CLIENT_TOKEN=changeme
IDENTITY_CONNECTORS_CLIENT_TOKEN=changeme
IDENTITY_OPTIMIZE_CLIENT_TOKEN=changeme

# Optional. PKCS8 PEM RSA private key used to sign JWTs. Leave unset for local dev - a fresh
# ephemeral key is generated at startup, which is fine for a single instance. In the real
# cluster this comes from the keycunda-signing-key Secret instead (see
# 2-install-camunda-microk8s.sh), so every replica shares the same key. Generate one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
#KEYCUNDA_JWT_SIGNING_KEY_PEM=
